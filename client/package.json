{
  "name": "stremdbc-client",
  "version": "1.4.0",
  "description": "StreamDBC single Windows Control Panel with bundled FFmpeg, Samsung F5500 fleet discovery/control, System Tray, gateway operations, and Cloudflare LAN DNS sync",
  "main": "main.js",
  "scripts": {
    "start": "npm run generate:icon && electron .",
    "build": "node build.js",
    "test": "node --test",
    "build:win": "npm run generate:icon && npm run vendor && npm run prepare-runtime && electron-builder --win nsis portable --publish never",
    "dev": "electron . --enable-logging",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "vendor": "node scripts/vendor-hls.js",
    "prestart": "npm run vendor",
    "prepack": "npm run vendor",
    "predist": "npm run vendor && npm run prepare-runtime",
    "prepare-runtime": "node scripts/prepare-server-runtime.js",
    "generate:icon": "node scripts/generate-windows-icon.js",
    "full-build-installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/windows/full-build-installer.ps1"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "node-fetch": "^3.3.2",
    "hls.js": "1.7.3"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.stremdbc.client",
    "productName": "StreamDBC Control Panel",
    "files": [
      "main.js",
      "preload.js",
      "samsung-fleet.js",
      "samsung-fleet-inventory.js",
      "hls-smoke.js",
      "window-lifecycle.js",
      "renderer.js",
      "styles.css",
      "index.html",
      "player.html",
      "player.js",
      "assets/**/*",
      "locales/**/*",
      "scripts/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "portable",
          "arch": "x64"
        }
      ],
      "icon": "assets/apps.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/apps.ico",
      "uninstallerIcon": "assets/apps.ico",
      "artifactName": "StreamDBC-Control-Panel-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "StreamDBC-Control-Panel-Portable-${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      },
      {
        "from": "server-runtime/",
        "to": "server-runtime/"
      }
    ]
  },
  "license": "MIT"
}
