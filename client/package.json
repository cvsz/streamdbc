{
  "name": "stremdbc-client",
  "version": "1.0.0",
  "description": "STREMDBC Full-Feature GUI Client for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node build.js",
    "build:win": "node build.js --windows",
    "dev": "electron . --enable-logging",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.stremdbc.client",
    "productName": "STREMDBC Client",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "styles.css",
      "index.html",
      "player.html",
      "player.js",
      "assets/**/*",
      "locales/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "portable",
          "arch": "x64"
        }
      ],
      "icon": "client-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "client-icon.ico",
      "uninstallerIcon": "client-icon.ico",
      "installerHeaderIcon": "client-icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "stremdbc-client-setup.exe"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      }
    ]
  },
  "license": "MIT"
}
