{
  "name": "stremdbc-client",
  "version": "1.1.0",
  "description": "StreamDBC Windows Control Panel with Samsung F5500 builder and streaming management",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node build.js",
    "build:win": "node build.js --windows",
    "dev": "electron . --enable-logging",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "vendor": "node scripts/vendor-hls.js",
    "prestart": "npm run vendor",
    "prepack": "npm run vendor",
    "predist": "npm run vendor"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "node-fetch": "^3.3.2",
    "hls.js": "1.7.3"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.stremdbc.client",
    "productName": "STREMDBC Client",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "styles.css",
      "index.html",
      "player.html",
      "player.js",
      "assets/**/*",
      "locales/**/*",
      "scripts/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "portable",
          "arch": "x64"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "stremdbc-client-setup.exe"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      }
    ]
  },
  "license": "MIT"
}
